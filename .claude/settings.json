{
  "permissions": {
    "ask": [
      "Bash(scripts/release.sh publish:*)",
      "Bash(./scripts/release.sh publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-release.sh"
          }
        ]
      }
    ]
  }
}
